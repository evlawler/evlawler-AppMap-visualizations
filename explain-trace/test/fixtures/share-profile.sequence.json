{
  "actors": [
    { "id": "package:web", "name": "web" },
    { "id": "package:auth", "name": "auth" },
    { "id": "package:profile", "name": "profile" },
    { "id": "database", "name": "Database" },
    { "id": "package:mailer", "name": "mailer" }
  ],
  "rootActions": [
    { "nodeType": 3, "callee": "package:web", "name": "shareProfile", "stableProperties": { "id": "web/Share.shareProfile" },
      "children": [
        { "nodeType": 3, "callee": "package:auth", "name": "requireLogin", "labels": ["security.authentication"] },
        { "nodeType": 3, "callee": "package:profile", "name": "loadProfile", "labels": ["security.pii"],
          "children": [
            { "nodeType": 6, "callee": "database", "query": "SELECT name, email FROM person" }
          ]
        },
        { "nodeType": 4, "callee": "package:mailer", "name": "sendShareEmail", "route": "POST https -//mail.example/send", "status": 202 }
      ]
    }
  ]
}
